<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:usesCleartextTraffic="true"
        android:name="com.vueo.shared.core.diagnostics.TiveoApplication"
        android:allowBackup="false"
        android:banner="@drawable/vueo_tv_banner_art"
        android:icon="@drawable/tiveo_tv_installer_icon"
        android:label="Tiveo"
        android:logo="@drawable/vueo_tv_logo"
        android:roundIcon="@drawable/tiveo_tv_installer_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VUEOTV">
        <activity
            android:name=".MainActivity"
            android:icon="@drawable/tiveo_tv_installer_icon"
            android:roundIcon="@drawable/tiveo_tv_installer_icon_round"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="Tiveo"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="virio"
                    android:host="watch-next" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="virio" android:host="channel" />
            </intent-filter>
        </activity>


        <receiver android:name=".channels.TvHomeChannelsReceiver" android:exported="true">
            <intent-filter><action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" /></intent-filter>
        </receiver>

        <receiver
            android:name="com.vueo.tv.update.TvUpdateInstallReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.vueo.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/vueo_tv_update_paths" />
        </provider>

    </application>
</manifest>
